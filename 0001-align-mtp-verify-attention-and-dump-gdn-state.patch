+def _snapshot_gdn_state(
+    backend: Qwen36Backend, slot: int, *, round_index: int, source_col: int
+) -> dict:
+    """Clone the active post-round GDN rows for graph/eager diagnosis.
+
+    ``slot_state().gdn_states`` is intentional: MTP ``activate()`` changes
+    those objects to point at the accepted spec row. Reading the base slot
+    pool row would silently compare the wrong state after a partial/full
+    accept. Cloning here is also required because the next draft/round mutates
+    the same pooled storage.
+    """
+    engine = backend._mtp
+    if engine._spec_rows is None:  # noqa: SLF001
+        raise RuntimeError("round-4 GDN probe requires MTP spec rows")
+    state = backend.pool.slot_state(slot)
+    active_col = engine._spec_state_col[slot]  # noqa: SLF001
+    layers: dict[int, dict[str, torch.Tensor]] = {}
+    for layer_idx, gdn_state in enumerate(state.gdn_states):
+        if gdn_state is None:
+            continue
+        layers[layer_idx] = {
+            "conv_state": gdn_state.conv_state.detach().cpu().clone(),
+            "recurrent_state": gdn_state.recurrent_state.detach().cpu().clone(),
+        }
+    return {
+        "round_index": round_index,
+        "slot": slot,
+        "source_col_before_round": source_col,
+        "source_row_before_round": engine._spec_rows.row_for_slot(  # noqa: SLF001
+            slot, source_col
+        ),
+        "active_col_after_round": active_col,
+        "active_row_after_round": engine._spec_rows.row_for_slot(slot, active_col),  # noqa: SLF001
+        "layers": layers,
+    }
+
+
+def _diff_gdn_states(graph_state: dict, eager_state: dict) -> bool:
+    """Print an exact per-layer/field state diff and return exact equality."""
+    print(
+        "GDN state provenance after round "
+        f"{graph_state['round_index']}: "
+        f"graph source_col={graph_state['source_col_before_round']} "
+        f"source_row={graph_state['source_row_before_round']} "
+        f"active_col={graph_state['active_col_after_round']} "
+        f"active_row={graph_state['active_row_after_round']}; "
+        f"eager source_col={eager_state['source_col_before_round']} "
+        f"source_row={eager_state['source_row_before_round']} "
+        f"active_col={eager_state['active_col_after_round']} "
+        f"active_row={eager_state['active_row_after_round']}"
+    )
+    state_exact = True
+    graph_layers = graph_state["layers"]
+    eager_layers = eager_state["layers"]
+    for layer_idx in sorted(set(graph_layers) | set(eager_layers)):
+        graph_layer = graph_layers.get(layer_idx)
+        eager_layer = eager_layers.get(layer_idx)
+        if graph_layer is None or eager_layer is None:
+            side = "graph" if graph_layer is None else "eager"
+            print(f"  layer={layer_idx}: missing on {side}")
+            state_exact = False
+            continue
+        for field in ("conv_state", "recurrent_state"):
+            graph_tensor = graph_layer[field]
+            eager_tensor = eager_layer[field]
+            if graph_tensor.shape != eager_tensor.shape:
+                print(
+                    f"  layer={layer_idx} field={field}: "
+                    f"shape graph={tuple(graph_tensor.shape)} "
+                    f"eager={tuple(eager_tensor.shape)}"
+                )
+                state_exact = False
+                continue
+            mismatch = int(torch.count_nonzero(graph_tensor != eager_tensor).item())
+            if mismatch:
+                delta = (graph_tensor.float() - eager_tensor.float()).abs()
+                max_abs = float(delta.max().item())
+                first = (graph_tensor != eager_tensor).nonzero(as_tuple=False)[0].tolist()
+                print(
+                    f"  layer={layer_idx} field={field}: exact=False "
+                    f"mismatches={mismatch}/{graph_tensor.numel()} "
+                    f"max_abs={max_abs:.8g} first_index={first}"
+                )
+                state_exact = False
+            else:
+                print(
+                    f"  layer={layer_idx} field={field}: exact=True "
+                    f"shape={tuple(graph_tensor.shape)}"
+                )
+    logits_exact = True
+    for index, name in enumerate(("anchor_logits", "verify_logits")):
+        graph_logits = graph_state["logits"][index]
+        eager_logits = eager_state["logits"][index]
+        exact = torch.equal(graph_logits, eager_logits)
+        if exact:
+            print(f"  {name}: exact=True shape={tuple(graph_logits.shape)}")
+        else:
+            delta = (graph_logits.float() - eager_logits.float()).abs()
+            mismatch = int(torch.count_nonzero(graph_logits != eager_logits).item())
+            print(
+                f"  {name}: exact=False mismatches={mismatch}/{graph_logits.numel()} "
+                f"max_abs={float(delta.max().item()):.8g}"
+            )
+        logits_exact = logits_exact and exact
+    print("GDN state exact:", state_exact)
+    print("Round-4 logits exact:", logits_exact)
+    return state_exact
+
+
