# Exact accepted local-vs-SGLang parity run. Source this file before using
# scripts/run_qwen38_128k_decode_bench.sh; the server and client commands are
# listed below because QSR_BENCH_* is intentionally not global runtime state.
export QSR_BENCH_PYTHON=/home/bot/.venvs/torch-nightly/bin/python
export QSR_BENCH_SPECULATIVE=dspark
export QSR_BENCH_BLOCK_SIZE=128
export QSR_PREFILL_CHUNK=8192
export QSR_ADMISSION_COALESCE_MS=10
export QSR_PREFIX_CACHE_IN_BATCH_DEDUP=1
export QSR_QWEN36_MLP_FP4_QUANT=flashinfer
export QSR_QWEN36_MLP_W4A4=1
export QSR_QWEN36_MLP_W4A4_ALL=1
export QSR_QWEN36_PREFILL_ATTN_BACKEND=flashinfer
export QSR_QWEN36_GDN_PREFILL_BACKEND=flashinfer

# Server:
# QSR_BENCH_TAG=qwen38_live_publish_c4_20260819 \
#   bash scripts/run_qwen38_128k_decode_bench.sh server
# Client:
# QSR_BENCH_TAG=qwen38_live_publish_c4_20260819 \
#   bash scripts/run_qwen38_128k_decode_bench.sh c4

# Diagnostic companion run (same workload, wall-clock round profile):
# QSR_BENCH_TAG=qwen38_live_profile_c4_20260819 \
# QSR_BENCH_PROFILE_ROUNDS=1 \
#   bash scripts/run_qwen38_128k_decode_bench.sh server
